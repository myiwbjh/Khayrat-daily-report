SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_STORAGE_BUCKET=khayrat-reports
ACCESS_CONTROL_REQUIRED=true
# All AI variables are SERVER ONLY. Keep disabled pending cost/transmission approval.
AI_FEATURES_APPROVED=false
AI_ALLOWED_USER_EMAILS=
VISION_PROVIDER=groq
VISION_MODEL=qwen/qwen3.8-27b
OPENAI_API_KEY=
# Free vision: confirm Groq account Free Plan, no paid upgrade,
# approve transmission to Groq, and enable Zero Data Retention before use.
GROQ_API_KEY=
GROQ_FREE_TIER_CONFIRMED=false
# Paid alternative (separate authorization): VISION_PROVIDER=openai,
# VISION_MODEL=gpt-4.1-mini-2025-04-14 and OPENAI_API_KEY.
OCR_ENABLED=false


# Server only, never NEXT_PUBLIC/VITE/browser config. Required for controlled public snapshot,
# photo proxy, administrator provisioning and individually confirmed logo cleanup.
SUPABASE_SERVICE_ROLE_KEY=
# Gemini is optional and disabled until a project key with BILLING DISABLED is configured.
# Free services forbid confidential/sensitive/personal information. Only non-confidential input.
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_BILLING_DISABLED_CONFIRMED=false
GEMINI_NONCONFIDENTIAL_USE_CONFIRMED=false
